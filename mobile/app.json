{
  "expo": {
    "name": "Kotariw",
    "slug": "kotariw-score",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a0533"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kotariw.game"
    },
    "android": {
      "package": "com.kotariw.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a3d2f"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "56a7bdef-b204-4df9-8956-b290f9217872"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
